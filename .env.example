# ---------------------------------------------------------------- TAK server
COT_URL=ssl://takserver:8089
# Client certificate and unencrypted key (PEM). Old names CLIENT_CERT and
# CLIENT_KEY still work.
PYTAK_TLS_CLIENT_CERT=/data/cert.pem
PYTAK_TLS_CLIENT_KEY=/data/key.pem
# 1 = do not verify the TAK server certificate
PYTAK_TLS_DONT_VERIFY=1
#PYTAK_TLS_CLIENT_CAFILE=/data/ca.pem

# ---------------------------------------------------------------- HSL
# Route ids or passenger route numbers, wildcards allowed (empty = all)
#HSL_ROUTE_FILTER=15,M1,M2,L*
#HSL_MQTT_BROKER=mqtt.hsl.fi
#HSL_MQTT_PORT=1883

# ---------------------------------------------------------------- Output
# Seconds between send rounds; vehicles that moved are sent every round
#UPDATE_INTERVAL=5
# Unmoved vehicles are re-sent this often (s)
#REFRESH_INTERVAL=20
# Marker lifetime in ATAK without new data (s)
#STALE_SECONDS=60
# Stop sending a vehicle that has been silent this long (s)
#MAX_AGE=120
#SOURCE_LINE=Source: HSL open data, CC BY 4.0

# ---------------------------------------------------------------- Health
# Unhealthy when no HSL data has arrived for this long (s, 0 = off)
#HEALTH_MAX_SILENCE=600
#DEBUG=0
